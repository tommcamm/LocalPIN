[Unit]
Description=LocalPIN same-boot password accounting migration
DefaultDependencies=no
IgnoreOnIsolate=yes
After=local-fs.target
RequiresMountsFor=/var/lib/localpin-integration /var/lib/faillock
OnFailure=emergency.target

[Service]
Type=oneshot
Slice=localpinmaintenance.slice
ExecStart=/usr/libexec/localpin/localpin-accounting run
# Session drain, target isolation, watchdog barrier and observed restoration
# each have their own bound. Retain enough time for all four plus preflight.
TimeoutStartSec=240
TimeoutStopSec=10
KillMode=process
UMask=0077
LimitCORE=0
